{
  "rules": {
    ".read": false,
    ".write": false,
    "lobby": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$rid": {
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (!newData.exists() && (root.child('rooms/' + $rid + '/meta/owner').val() === auth.uid || root.child('rooms/' + $rid + '/meta/createdAt').val() <= now - 259200000 || !root.child('rooms/' + $rid + '/meta').exists())))",
        ".validate": "$rid.matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$/) && newData.hasChildren(['name', 'private', 'owner', 'createdAt']) && newData.parent().parent().child('rooms/' + $rid + '/meta/owner').val() === auth.uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "private": {
          ".validate": "newData.isBoolean()"
        },
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "secrets": {
      "$rid": {
        ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('rooms/' + $rid + '/meta/owner').val() === auth.uid) || (!newData.exists() && (root.child('rooms/' + $rid + '/meta/owner').val() === auth.uid || root.child('rooms/' + $rid + '/meta/createdAt').val() <= now - 259200000 || !root.child('rooms/' + $rid + '/meta').exists())))",
        ".validate": "newData.isString() && newData.val().matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$/)"
      }
    },
    "rooms": {
      "$room": {
        ".write": "auth != null && !newData.exists() && (data.child('meta/owner').val() === auth.uid || data.child('meta/createdAt').val() <= now - 259200000)",
        ".validate": "$room.matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$/)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['createdAt', 'owner', 'name', 'private'])",
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "owner": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "private": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "keys": {
          "$uid": {
            ".write": "$uid === auth.uid",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('secrets').child($room).val()"
          }
        },
        "slots": {
          ".read": "auth != null",
          "$slot": {
            ".write": "auth != null && (data.val() === auth.uid || (!data.exists() && newData.val() === auth.uid))",
            ".validate": "($slot === 'a' || $slot === 'b') && newData.val() === auth.uid && newData.parent().parent().child('meta').exists() && newData.parent().parent().child('meta/createdAt').val() > now - 259200000 && (newData.parent().parent().child('meta/private').val() !== true || newData.parent().parent().child('keys/' + auth.uid).exists())"
          }
        },
        "strokes": {
          ".read": "(root.child('rooms/' + $room + '/slots/a').val() === auth.uid || root.child('rooms/' + $room + '/slots/b').val() === auth.uid)",
          ".write": "(root.child('rooms/' + $room + '/slots/a').val() === auth.uid || root.child('rooms/' + $room + '/slots/b').val() === auth.uid) && !newData.exists()",
          "$sid": {
            ".write": "(root.child('rooms/' + $room + '/slots/a').val() === auth.uid || root.child('rooms/' + $room + '/slots/b').val() === auth.uid) && (!newData.exists() || root.child('rooms/' + $room + '/meta/createdAt').val() > now - 259200000)",
            ".validate": "newData.hasChildren(['u', 't', 'c', 's', 'sd', 'p'])",
            "u": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().matches(/^(pencil|pixel|wave|paint|outline|eraser)$/)"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 400"
            },
            "sd": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "px": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
            },
            "a": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
            },
            "wl": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 800"
            },
            "sh": {
              ".validate": "newData.isString() && newData.val().matches(/^(zigzag|sine|coil)$/)"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60000 && newData.val().matches(/^[0-9,-]+$/)"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "fl": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "oc": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
            },
            "ow": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100"
            },
            "pw": {
              ".validate": "newData.isString() && newData.val().length <= 30000 && newData.val().matches(/^[0-9,]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "live": {
          ".read": "(root.child('rooms/' + $room + '/slots/a').val() === auth.uid || root.child('rooms/' + $room + '/slots/b').val() === auth.uid)",
          "$uid": {
            ".write": "$uid === auth.uid && (!newData.exists() || ((root.child('rooms/' + $room + '/slots/a').val() === auth.uid || root.child('rooms/' + $room + '/slots/b').val() === auth.uid) && root.child('rooms/' + $room + '/meta/createdAt').val() > now - 259200000))",
            ".validate": "newData.hasChildren(['u', 't', 'c', 's', 'sd', 'p'])",
            "u": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().matches(/^(pencil|pixel|wave|paint|outline|eraser)$/)"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 400"
            },
            "sd": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "px": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
            },
            "a": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
            },
            "wl": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 800"
            },
            "sh": {
              ".validate": "newData.isString() && newData.val().matches(/^(zigzag|sine|coil)$/)"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60000 && newData.val().matches(/^[0-9,-]+$/)"
            },
            "fl": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "oc": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
            },
            "ow": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100"
            },
            "pw": {
              ".validate": "newData.isString() && newData.val().length <= 30000 && newData.val().matches(/^[0-9,]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
